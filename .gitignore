# Python
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
venv/
env/
ENV/

# IDEs
.idea/
.vscode/

# Obsidian vault: local UI, plugins, cache and device-specific settings.
# Project notes remain versionable; see sync_branch.bat for clean protection.
.obsidian/

# Project specific
*.xlsx
*.csv
!examples/*.csv

# Data
onedrive_backup/
/pyweatherfiles_backup/

# Tutorial notebook generated outputs
examples/tutorial_output/

# Case-study tutorial notebook (docs/source/jupyter_notebooks/): notebook +
# input data are deliberately version-controlled (so it can be cloned from
# GitHub and executed standalone, and rendered on Read the Docs), unlike the
# rest of the repository's *.xlsx datasets. Generated outputs (EPW/CSV/XLSX
# exports, .pkl/.json sessions) are not tracked.
!docs/source/jupyter_notebooks/data/*.xlsx
docs/source/jupyter_notebooks/case_study_output/
docs/source/jupyter_notebooks/data/*.pkl
docs/source/jupyter_notebooks/data/*.json

# Sphinx documentation build output (final HTML, easily regenerated, not tracked)
docs/build/
docs/source/.jupyter_cache/

# NOTE: docs/source/api/ (sphinx-apidoc stubs) and docs/source/tutorial_pyweatherfiles.ipynb
# are auto-regenerated on every docs build (see dist_build_docs.bat / docs/source/conf.py),
# but they ARE intentionally committed as a GitHub backup in case the Read the Docs build
# or local toolchain is ever unavailable. examples/tutorial_pyweatherfiles.ipynb remains the
# single source of truth for the notebook; the copy under docs/source/ must stay in sync with
# it (re-run dist_build_docs.bat, or copy it manually, before committing changes to either).

